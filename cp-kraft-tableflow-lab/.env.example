BASE_URL=https://api.warpstream.com
API_KEY=
VIRTUAL_CLUSTER_ID=
PIPELINE_ID=
CONFIG_ID=

# Host-side producer listener. Tableflow uses cp-server:9090 inside Docker.
BROKER=localhost:19090
TABLEFLOW_BROKER_HOST=cp-server
TABLEFLOW_BROKER_PORT=9090
TABLEFLOW_BUCKET_URL=file:///tmp/tableflow-iceberg

# Set this to the same Tableflow cluster ID as VIRTUAL_CLUSTER_ID.
WARPSTREAM_DEFAULT_VIRTUAL_CLUSTER_ID=
WARPSTREAM_AGENT_KEY=
WARPSTREAM_REGION=ap-southeast-1
